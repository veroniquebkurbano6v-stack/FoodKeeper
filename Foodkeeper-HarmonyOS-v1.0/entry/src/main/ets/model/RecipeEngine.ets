// ===== 优先级算法 =====

// 菜谱评分结果
interface RecipeScore {
  score: number;
  ings: MatchedIngredient[];
  expiringCount: number;
  haveCount: number;
  needBuyNames: string[];
}

// 查找库存中某食材的剩余天数；-999 表示未找到
function findFoodDays(foods: FoodItem[], name: string): number {
  for (let i = 0; i < foods.length; i++) {
    const f = foods[i];
    if (f.name === name && f.quantity > 0) {
      return daysUntilExpiry(f.expiryDate);
    }
  }
  return -999;
}

// 判断是否临期（剩余 0-3 天，含已过期）
// 【临期判断标准】days <= 3 即视为临期，分三档：
//   已过期 days < 0   → 优先消耗，避免浪费
//   紧急临期 0-1 天   → 最高优先级
//   临期 2-3 天       → 高优先级
function checkExpiring(days: number): boolean {
  return days <= 3;
}

// 获取库存中所有临期食材名称（去重），按紧急程度升序（最紧急在前）
// 用于"全覆盖临期食材"策略：优先为最紧急的食材匹配菜谱
function getExpiringIngredientNames(foods: FoodItem[]): string[] {
  // 用简单对象数组代替 Map，避免 ArkTS 对 Map.forEach 的限制
  const names: string[] = [];
  const daysArr: number[] = [];
  for (let i = 0; i < foods.length; i++) {
    const f = foods[i];
    if (f.quantity <= 0) continue;
    const days = daysUntilExpiry(f.expiryDate);
    if (days <= 3) {
      // 查找是否已存在同名食材
      let idx = -1;
      for (let j = 0; j < names.length; j++) {
        if (names[j] === f.name) { idx = j; break; }
      }
      if (idx === -1) {
        names.push(f.name);
        daysArr.push(days);
      } else if (days < daysArr[idx]) {
        // 取最小剩余天数（最紧急）
        daysArr[idx] = days;
      }
    }
  }
  // 按紧急程度升序排序（days 越小越紧急，已过期 days<0 最优先）
  // 同步交换 names 与 daysArr
  for (let i = 0; i < daysArr.length - 1; i++) {
    for (let j = i + 1; j < daysArr.length; j++) {
      if (daysArr[j] < daysArr[i]) {
        const tmpD = daysArr[i]; daysArr[i] = daysArr[j]; daysArr[j] = tmpD;
        const tmpN = names[i]; names[i] = names[j]; names[j] = tmpN;
      }
    }
  }
  return names;
}

// 判断菜谱是否使用了指定食材（用于全覆盖策略中查找覆盖某临期食材的菜谱）
function recipeUsesIngredient(recipe: DisplayRecipe, ingredientName: string): boolean {
  for (let i = 0; i < recipe.ingredients.length; i++) {
    if (recipe.ingredients[i].name === ingredientName) {
      return true;
    }
  }
  return false;
}

// 计算单道菜谱的优先级得分
// 得分规则：
//   库存拥有该食材      +5  分
//   已过期（days < 0）  +8  分（优先消耗，避免浪费）
//   紧急临期（0-1 天）  +15 分（最高优先级）
//   临期（2-3 天）      +10 分
//   库存没有该食材      -2  分（需购买，降低优先级）
//   使用 2+ 临期食材    +10 分（加成奖励）
function scoreRecipe(recipe: RecipeTemplate, foods: FoodItem[]): RecipeScore {
  let score = 0;
  let expiringCount = 0;
  let haveCount = 0;
  const ings: MatchedIngredient[] = [];
  const needBuyNames: string[] = [];

  for (let i = 0; i < recipe.ingredients.length; i++) {
    const ing = recipe.ingredients[i];
    const days = findFoodDays(foods, ing.name);
    if (days !== -999) {
      const expiring = checkExpiring(days);
      const matched: MatchedIngredient = {
        name: ing.name,
        quantity: ing.quantity,
        haveIt: true,
        days: days,
        isExpiring: expiring,
      };
      ings.push(matched);
      haveCount++;
      score += 5; // 拥有该食材
      if (days < 0) {
        score += 8;  // 已过期
        expiringCount++;
      } else if (days <= 1) {
        score += 15; // 紧急临期
        expiringCount++;
      } else if (days <= 3) {
        score += 10; // 临期
        expiringCount++;
      }
    } else {
      const matched: MatchedIngredient = {
        name: ing.name,
        quantity: ing.quantity,
        haveIt: false,
        days: 0,
        isExpiring: false,
      };
      ings.push(matched);
      needBuyNames.push(ing.name);
      score -= 2; // 需购买
    }
  }

  // 使用 2 个及以上临期食材，额外加成
  if (expiringCount >= 2) {
    score += 10;
  }

  const result: RecipeScore = {
    score: score,
    ings: ings,
    expiringCount: expiringCount,
    haveCount: haveCount,
    needBuyNames: needBuyNames,
  };
  return result;
}

// ===== 生成菜谱（返回 5-7 道，临期食材全覆盖 + 用户偏好） =====
// 算法分两阶段：
//   阶段1（全覆盖临期食材）：遍历所有临期食材（按紧急度升序），
//     为每个尚未被覆盖的临期食材挑选得分最高且未选中的菜谱。
//     —— 避免对单一临期食材反复推荐不同食谱，确保每项临期食材都有对应菜谱。
//   阶段2（填充剩余名额）：从剩余高分菜谱中按得分降序填充至 5-7 道。
// options.excludeNames：上一次已生成过的菜谱名单，对其施加大惩罚使其排到末尾
//   —— 保证"重新生成"结果与上一次完全不同；若可用菜谱不足仍会回填（避免空列表）
// options.favoriteNames：用户收藏的菜谱名单，每项加 5 分（兼顾用户饮食偏好）
export function generateRecipes(foods: FoodItem[], options?: RecipeGenOptions): DisplayRecipe[] {
  const scored: DisplayRecipe[] = [];
  const excludeSet: Set<string> = new Set<string>();
  const favoriteSet: Set<string> = new Set<string>();
  if (options) {
    if (options.excludeNames) {
      for (let i = 0; i < options.excludeNames.length; i++) {
        excludeSet.add(options.excludeNames[i]);
      }
    }
    if (options.favoriteNames) {
      for (let i = 0; i < options.favoriteNames.length; i++) {
        favoriteSet.add(options.favoriteNames[i]);
      }
    }
  }

  for (let i = 0; i < RECIPE_DATABASE.length; i++) {
    const t = RECIPE_DATABASE[i];
    const result = scoreRecipe(t, foods);
    // 上次已出现过的菜谱：施加大惩罚（-10000），使其排到末尾
    // 不直接 filter，确保排除后剩余不足 count 时仍能回填，避免返回空列表
    const penalty = excludeSet.has(t.name) ? -10000 : 0;
    // 收藏菜谱加成（兼顾用户偏好）
    const favoriteBonus = favoriteSet.has(t.name) ? 5 : 0;
    const recipe: DisplayRecipe = {
      name: t.name,
      time: t.time,
      calories: t.calories,
      caloriesNum: t.caloriesNum,
      difficulty: t.difficulty,
      category: t.category,
      ingredients: result.ings,
      stepList: t.stepList,
      steps: t.stepList.length,
      needBuyNames: result.needBuyNames,
      haveCount: result.haveCount,
      totalCount: t.ingredients.length,
      expiringCount: result.expiringCount,
      priorityScore: result.score + Math.random() * 3 + penalty + favoriteBonus,
    };
    scored.push(recipe);
  }

  // 按得分降序排序（阶段1与阶段2都依赖此排序）
  scored.sort((a: DisplayRecipe, b: DisplayRecipe) => b.priorityScore - a.priorityScore);

  const count = 5 + Math.floor(Math.random() * 3); // 5, 6, 或 7
  const maxCount = Math.min(count, scored.length);

  // ===== 阶段1：全覆盖临期食材 =====
  // 遍历所有临期食材，为每个尚未被覆盖的食材挑选最佳菜谱
  const expiringNames = getExpiringIngredientNames(foods);
  const selected: DisplayRecipe[] = [];
  const selectedNames: Set<string> = new Set<string>();
  const coveredExpiring: Set<string> = new Set<string>();

  for (let i = 0; i < expiringNames.length; i++) {
    if (coveredExpiring.has(expiringNames[i])) continue;
    // 在已排序的候选菜谱中查找使用了该临期食材且未选中的最佳菜谱
    let picked: DisplayRecipe | null = null;
    for (let j = 0; j < scored.length; j++) {
      if (selectedNames.has(scored[j].name)) continue;
      if (recipeUsesIngredient(scored[j], expiringNames[i])) {
        picked = scored[j];
        break;
      }
    }
    if (picked !== null) {
      selected.push(picked as DisplayRecipe);
      selectedNames.add((picked as DisplayRecipe).name);
      // 标记该菜谱包含的所有临期食材为已覆盖
      const pickedRecipe = picked as DisplayRecipe;
      for (let k = 0; k < pickedRecipe.ingredients.length; k++) {
        if (pickedRecipe.ingredients[k].isExpiring) {
          coveredExpiring.add(pickedRecipe.ingredients[k].name);
        }
      }
      if (selected.length >= maxCount) break;
    }
  }

  // ===== 阶段2：填充剩余名额 =====
  // 从剩余高分菜谱中按得分降序补充至 maxCount 道
  if (selected.length < maxCount) {
    for (let i = 0; i < scored.length; i++) {
      if (selected.length >= maxCount) break;
      if (selectedNames.has(scored[i].name)) continue;
      selected.push(scored[i]);
      selectedNames.add(scored[i].name);
    }
  }

  // 按得分降序排序最终结果（阶段1挑选的菜谱可能不是严格降序）
  selected.sort((a: DisplayRecipe, b: DisplayRecipe) => b.priorityScore - a.priorityScore);

  return selected;
}
