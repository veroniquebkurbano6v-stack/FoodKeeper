// 智能菜谱生成引擎
// 基于库存食材 + 临期优先算法，自动生成 5-7 道菜谱推荐
// 优先使用临期食材（剩余天数越少优先级越高），确保食材不浪费

import { FoodItem } from './DataModel';
import { daysUntilExpiry } from '../utils/ExpiryHelper';

// ===== 菜谱食材模板（仅需名称与用量，剩余天数运行时匹配库存） =====
export interface RecipeIngredientTemplate {
  name: string;
  quantity: string;
}

// ===== 匹配库存后的食材 =====
export interface MatchedIngredient {
  name: string;
  quantity: string;
  haveIt: boolean;       // 库存是否拥有
  days: number;          // 拥有时的剩余天数
  isExpiring: boolean;   // 是否临期（剩余 <= 3 天）
}

// ===== 结构化烹饪步骤（新手友好：标题+详细说明+火候+用时+小贴士） =====
export interface RecipeStep {
  title: string;     // 步骤标题（短句，如"准备食材"、"热锅炒蛋"）
  detail: string;    // 详细操作说明（含量化：用量/时间/火候/动作要领）
  heat: string;      // 火候（如"大火"/"中火"/"小火"/"无需加热"）
  duration: string;  // 本步用时（如"5分钟"/"即时"/"10-15分钟"）
  tip: string;       // 小贴士/注意事项（可为空字符串''）
}

// ===== 菜谱模板 =====
export interface RecipeTemplate {
  name: string;
  time: string;
  calories: string;
  caloriesNum: number;
  difficulty: string;
  category: number;      // 0=快手懒人餐, 1=家常正餐, 2=减脂轻食餐
  ingredients: RecipeIngredientTemplate[];
  stepList: RecipeStep[];
}

// ===== 运行时菜谱（匹配库存后） =====
export interface DisplayRecipe {
  name: string;
  time: string;
  calories: string;
  caloriesNum: number;
  difficulty: string;
  category: number;
  ingredients: MatchedIngredient[];
  stepList: RecipeStep[];
  steps: number;
  needBuyNames: string[];
  haveCount: number;
  totalCount: number;
  expiringCount: number;   // 使用的临期食材数量
  priorityScore: number;   // 优先级得分
}

// ===== 菜谱生成选项 =====
export interface RecipeGenOptions {
  excludeNames?: string[];      // 上一次已生成过的菜谱名单（重新生成时排除）
  favoriteNames?: string[];     // 用户收藏的菜谱名单（评分加成，兼顾用户偏好）
}

// ===== 菜谱详情页数据传递 Holder（任务4：RecipePage → RecipeDetailPage） =====
// 由于 DisplayRecipe 含嵌套数组，不便通过 router 参数直接传递，使用单例 Holder 中转
// 同时记录最近完成烹饪的菜谱名，供 RecipePage 返回后标记 completedSet
export class RecipeHolder {
  private static current: DisplayRecipe | null = null;
  private static lastCompleted: string | null = null;
  static set(recipe: DisplayRecipe): void { RecipeHolder.current = recipe; }
  static get(): DisplayRecipe | null { return RecipeHolder.current; }
  static clear(): void { RecipeHolder.current = null; }
  static setLastCompleted(name: string): void { RecipeHolder.lastCompleted = name; }
  static getLastCompleted(): string | null { return RecipeHolder.lastCompleted; }
  static clearLastCompleted(): void { RecipeHolder.lastCompleted = null; }
}

