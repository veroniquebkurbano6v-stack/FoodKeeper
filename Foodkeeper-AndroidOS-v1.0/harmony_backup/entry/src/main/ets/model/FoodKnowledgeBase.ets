// 内部索引（懒加载）
interface FoodIndex {
  nameMap: Map<string, FoodKnowledge>;     // 名称(小写) -> 知识条目
  aliasMap: Map<string, FoodKnowledge>;    // 别名(小写) -> 知识条目
}

let _index: FoodIndex | null = null;

function buildIndex(): FoodIndex {
  const nameMap = new Map<string, FoodKnowledge>();
  const aliasMap = new Map<string, FoodKnowledge>();
  for (let i = 0; i < FOOD_KNOWLEDGE_LIST.length; i++) {
    const k = FOOD_KNOWLEDGE_LIST[i];
    nameMap.set(k.name.toLowerCase(), k);
    for (let j = 0; j < k.aliases.length; j++) {
      const a = k.aliases[j];
      if (a.length > 0) {
        aliasMap.set(a.toLowerCase(), k);
      }
    }
  }
  return { nameMap, aliasMap };
}

function getIndex(): FoodIndex {
  if (_index === null) {
    _index = buildIndex();
  }
  return _index;
}

/**
 * 根据用户输入的食材名称匹配知识库条目
 * 匹配优先级（与原应用 hA 函数一致）：
 *   1. 名称精确匹配（忽略大小写）
 *   2. 别名精确匹配（忽略大小写）
 *   3. 输入长度>=2 时，名称包含匹配（name.includes(input) 或 input.includes(name)）
 *   4. 输入长度>=2 时，别名包含匹配
 *   5. 未命中返回 null
 */
export function matchFood(input: string): FoodKnowledge | null {
  const t = (input || '').trim().toLowerCase();
  if (t.length === 0) return null;
  const idx = getIndex();
  // 1. 名称精确匹配
  const byName = idx.nameMap.get(t);
  if (byName !== undefined) return byName;
  // 2. 别名精确匹配
  const byAlias = idx.aliasMap.get(t);
  if (byAlias !== undefined) return byAlias;
  // 3. 长度>=2 时模糊匹配名称
  if (t.length >= 2) {
    for (let i = 0; i < FOOD_KNOWLEDGE_LIST.length; i++) {
      const k = FOOD_KNOWLEDGE_LIST[i];
      const kn = k.name.toLowerCase();
      if (kn.includes(t) || t.includes(kn)) return k;
    }
    // 4. 模糊匹配别名
    for (let i = 0; i < FOOD_KNOWLEDGE_LIST.length; i++) {
      const k = FOOD_KNOWLEDGE_LIST[i];
      for (let j = 0; j < k.aliases.length; j++) {
        const a = k.aliases[j].toLowerCase();
        if (a.length > 0 && (a.includes(t) || t.includes(a))) return k;
      }
    }
  }
  return null;
}

// 获取知识库条数
export function getKnowledgeCount(): number {
  return FOOD_KNOWLEDGE_LIST.length;
}
