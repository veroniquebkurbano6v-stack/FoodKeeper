# 食库管家 - Spring Boot 后端 .gitignore

# ==================== Maven ====================
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# ==================== IDE ====================
# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr
out/

# Eclipse
.settings/
.classpath
.project
.metadata/
bin/
tmp/

# VS Code
.vscode/

# NetBeans
nbproject/
nbbuild/
dist/
nbdist/
.nb-gradle/

# ==================== Java ====================
*.class
*.jar
*.war
*.ear
*.log
*.ctxt
*.bak
hs_err_pid*
replay_pid*

# ==================== Spring Boot ====================
# 日志文件
logs/
*.log

# 打包文件
*.jar.original

# ==================== 配置文件（敏感信息） ====================
# 生产环境配置（包含敏感信息）
# 注意：生产配置应通过环境变量注入，不应提交到仓库
application-prod.yml

# 本地开发配置覆盖
application-local.yml

# ==================== 操作系统 ====================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~

# ==================== 其他 ====================
# 临时文件
*.tmp
*.temp
*.swp
*.swo

# 备份文件
*.bak
*.backup

# 敏感配置（禁止提交）
*.pem
*.key
*.p12
*.jks

# 数据库文件（禁止提交）
*.sql
*.db
*.sqlite