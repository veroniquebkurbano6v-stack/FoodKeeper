<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.food.mapper.UserMapper">

    <!-- ============================================ -->
    <!-- 结果映射：用户表字段与实体类字段映射          -->
    <!-- ============================================ -->
    <resultMap id="BaseResultMap" type="com.food.entity.UserDO">
        <id column="id" property="id"/>
        <result column="username" property="username"/>
        <result column="password" property="password"/>
        <result column="nickname" property="nickname"/>
        <result column="phone" property="phone"/>
        <result column="email" property="email"/>
        <result column="avatar" property="avatar"/>
        <result column="gender" property="gender"/>
        <result column="status" property="status"/>
        <result column="last_login_time" property="lastLoginTime"/>
        <result column="last_login_ip" property="lastLoginIp"/>
        <result column="remark" property="remark"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
        <result column="deleted" property="deleted"/>
    </resultMap>

    <!-- ============================================ -->
    <!-- SQL 片段：基础字段列表（不包含密码）         -->
    <!-- ============================================ -->
    <sql id="Base_Column_List">
        id, username, nickname, phone, email, avatar, gender, status,
        last_login_time, last_login_ip, remark, created_at, updated_at, deleted
    </sql>

    <!-- ============================================ -->
    <!-- SQL 片段：含密码字段列表                     -->
    <!-- ============================================ -->
    <sql id="Base_Column_List_With_Password">
        id, username, password, nickname, phone, email, avatar, gender, status,
        last_login_time, last_login_ip, remark, created_at, updated_at, deleted
    </sql>

    <!-- ============================================ -->
    <!-- 根据用户名查询用户（含密码）                 -->
    <!-- 用于登录认证                                  -->
    <!-- ============================================ -->
    <select id="selectByUsernameWithPassword" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List_With_Password"/>
        FROM sys_user
        WHERE username = #{username}
          AND deleted = 0
        LIMIT 1
    </select>

    <!-- ============================================ -->
    <!-- 根据用户名查询用户（不含密码）               -->
    <!-- 用于重复校验                                  -->
    <!-- ============================================ -->
    <select id="selectByUsername" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM sys_user
        WHERE username = #{username}
          AND deleted = 0
        LIMIT 1
    </select>

    <!-- ============================================ -->
    <!-- 根据手机号查询用户                           -->
    <!-- ============================================ -->
    <select id="selectByPhone" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM sys_user
        WHERE phone = #{phone}
          AND deleted = 0
        LIMIT 1
    </select>

    <!-- ============================================ -->
    <!-- 分页查询用户列表                             -->
    <!-- 支持关键词搜索、状态筛选                       -->
    <!-- ============================================ -->
    <select id="selectUserPage" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM sys_user
        WHERE deleted = 0
        <!-- 关键词搜索：用户名 / 昵称 / 手机号 -->
        <if test="keyword != null and keyword != ''">
            AND (
                username LIKE CONCAT('%', #{keyword}, '%')
                OR nickname LIKE CONCAT('%', #{keyword}, '%')
                OR phone LIKE CONCAT('%', #{keyword}, '%')
            )
        </if>
        <!-- 状态筛选 -->
        <if test="status != null">
            AND status = #{status}
        </if>
        ORDER BY id DESC
    </select>

    <!-- ============================================ -->
    <!-- 批量更新用户状态                             -->
    <!-- ============================================ -->
    <update id="batchUpdateStatus">
        UPDATE sys_user
        SET status = #{status},
            updated_at = NOW()
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        AND deleted = 0
    </update>

    <!-- ============================================ -->
    <!-- 更新用户密码                                 -->
    <!-- ============================================ -->
    <update id="updatePassword">
        UPDATE sys_user
        SET password = #{newPassword},
            updated_at = NOW()
        WHERE id = #{userId}
          AND deleted = 0
    </update>

    <!-- ============================================ -->
    <!-- 更新最后登录信息                             -->
    <!-- ============================================ -->
    <update id="updateLastLoginInfo">
        UPDATE sys_user
        SET last_login_time = #{loginTime},
            last_login_ip = #{loginIp},
            updated_at = NOW()
        WHERE id = #{userId}
          AND deleted = 0
    </update>

</mapper>