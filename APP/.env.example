# ============================================
# 环境变量配置文件
# ============================================

# MySQL 配置
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=food_inventory
MYSQL_USER=food_user
MYSQL_PASSWORD=food123
MYSQL_ROOT_PASSWORD=root123

# Redis 配置
REDIS_HOST=redis
REDIS_PORT=6379

# Jasypt 加密密钥（生产环境必须修改）
JASYPT_PASSWORD=prod-secret-key-change-me

# 应用配置
BACKEND_PROFILE=prod
BACKEND_PORT=8080
FRONTEND_PORT=80

# 镜像仓库（GitHub Container Registry）
REGISTRY=ghcr.io
IMAGE_PREFIX=your-github-username/food-inventory